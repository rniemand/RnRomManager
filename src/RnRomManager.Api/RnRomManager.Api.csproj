<Project Sdk="Microsoft.NET.Sdk.Web">

  <ItemGroup>
    <ProjectReference Include="../RnRomManager.Core/RnRomManager.Core.csproj" />
    <ProjectReference Include="../RnRomManager.Data/RnRomManager.Data.csproj" />
    <ProjectReference Include="../RnRomManager.Systems.GameBoy/RnRomManager.Systems.GameBoy.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="MySqlConnector" />
    <PackageReference Include="NLog.Web.AspNetCore" />
  </ItemGroup>

  <ItemGroup>
    <Content Update="nlog.config" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <!-- Local Release convenience: bundle the built SPA if it exists. The Dockerfile does the real copy. -->
  <Target Name="CopyWebBuild" BeforeTargets="BeforeBuild" Condition="'$(Configuration)' == 'Release' And Exists('../RnRomManager.Web/build/index.html')">
    <ItemGroup>
      <WebBuildFile Include="../RnRomManager.Web/build/**" />
    </ItemGroup>
    <Copy SourceFiles="@(WebBuildFile)" DestinationFiles="@(WebBuildFile->'wwwroot/%(RecursiveDir)%(Filename)%(Extension)')" SkipUnchangedFiles="true" />
  </Target>

</Project>
