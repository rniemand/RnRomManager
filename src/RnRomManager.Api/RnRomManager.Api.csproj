<Project Sdk="Microsoft.NET.Sdk.Web">

  <ItemGroup>
    <ProjectReference Include="../RnRomManager.Core/RnRomManager.Core.csproj" />
    <ProjectReference Include="../RnRomManager.Data/RnRomManager.Data.csproj" />
    <ProjectReference Include="../RnRomManager.Systems.GameBoy/RnRomManager.Systems.GameBoy.csproj" />
    <ProjectReference Include="../RnRomManager.Systems.Nintendo64/RnRomManager.Systems.Nintendo64.csproj" />
    <ProjectReference Include="../RnRomManager.Systems.Nes/RnRomManager.Systems.Nes.csproj" />
    <ProjectReference Include="../RnRomManager.Systems.Snes/RnRomManager.Systems.Snes.csproj" />
    <ProjectReference Include="../RnRomManager.Systems.Atari/RnRomManager.Systems.Atari.csproj" />
    <ProjectReference Include="../RnRomManager.Systems.Coleco/RnRomManager.Systems.Coleco.csproj" />
    <ProjectReference Include="../RnRomManager.Systems.Sega/RnRomManager.Systems.Sega.csproj" />
    <ProjectReference Include="../RnRomManager.Systems.Nec/RnRomManager.Systems.Nec.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Http.Resilience" />
    <PackageReference Include="MySqlConnector" />
    <PackageReference Include="NLog.Web.AspNetCore" />
  </ItemGroup>

  <ItemGroup>
    <Content Update="nlog.config" CopyToOutputDirectory="PreserveNewest" />
    <Content Remove="licenses.json" />
    <EmbeddedResource Include="licenses.json" LogicalName="RnRomManager.Api.licenses.json" />
  </ItemGroup>

  <!-- Local Release convenience: bundle the built SPA if it exists. The Dockerfile does the real copy. -->
  <Target Name="CopyWebBuild" BeforeTargets="BeforeBuild" Condition="'$(Configuration)' == 'Release' And Exists('../RnRomManager.Web/build/index.html')">
    <ItemGroup>
      <WebBuildFile Include="../RnRomManager.Web/build/**" />
    </ItemGroup>
    <Copy SourceFiles="@(WebBuildFile)" DestinationFiles="@(WebBuildFile->'wwwroot/%(RecursiveDir)%(Filename)%(Extension)')" SkipUnchangedFiles="true" />
  </Target>

</Project>
