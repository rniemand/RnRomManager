<?xml version="1.0" encoding="utf-8"?>
<!-- Spec §13. logDir, minLevel and retentionDays are set from configuration at startup (NLogSetup). -->
<nlog xmlns="http://www.nlog-project.org/schemas/NLog.xsd"
      xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      throwConfigExceptions="true">

  <extensions>
    <add assembly="NLog.Web.AspNetCore" />
  </extensions>

  <variable name="logDir" value="." />
  <variable name="minLevel" value="Debug" />
  <variable name="retentionDays" value="14" />
  <variable name="line" value="${date:universalTime=true:format=o}|${level:uppercase=true}|${logger}|${threadid}|${scopeproperty:JobId}|${scopeproperty:FileId}|${aspnet-TraceIdentifier}|${message}${onexception:${newline}${exception:format=tostring}}" />

  <targets>
    <target xsi:type="Console" name="console" layout="${line}" />
    <!-- One file per UTC day, no NLog archiving: the app purges old files itself (spec §13).
         NLog 6 has no concurrentWrites option; it only supports one writing process, which is what we need. -->
    <target xsi:type="File" name="file"
            fileName="${var:logDir}/rnrommanager-${date:universalTime=true:format=yyyy-MM-dd}.log"
            layout="${line}"
            keepFileOpen="true" />
    <!-- The last 500 events for the Admin Logs tab (L1); gets exactly what the file gets. -->
    <target xsi:type="LiveLog" name="live" />
  </targets>

  <rules>
    <logger name="Microsoft.Hosting.Lifetime" minlevel="Info" writeTo="console,file,live" final="true" />
    <logger name="Microsoft.*" minlevel="Warn" writeTo="console,file,live" final="true" />
    <logger name="Microsoft.*" final="true" />
    <logger name="System.*" minlevel="Warn" writeTo="console,file,live" final="true" />
    <logger name="System.*" final="true" />
    <logger name="RnRomManager.*" minlevel="${var:minLevel}" writeTo="console,file,live" final="true" />
    <logger name="RnRomManager.*" final="true" />
    <logger name="*" minlevel="Warn" writeTo="console,file,live" />
  </rules>
</nlog>
