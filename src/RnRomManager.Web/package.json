{
	"name": "rnrommanager-web",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"predev": "node scripts/vendor-emulatorjs.mjs",
		"build": "vite build",
		"prebuild": "node scripts/vendor-emulatorjs.mjs",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"lint": "eslint . && prettier --check .",
		"format": "prettier --write .",
		"test": "vitest run"
	},
	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"@sveltejs/adapter-static": "^4.0.1",
		"@sveltejs/kit": "^3.0.0",
		"@sveltejs/vite-plugin-svelte": "^7.2.0",
		"@testing-library/svelte": "^5.4.2",
		"@types/node": "^24",
		"eslint": "^10.4.1",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.19.0",
		"globals": "^17.6.0",
		"jsdom": "^29.1.1",
		"prettier": "^3.8.3",
		"prettier-plugin-svelte": "^4.1.0",
		"svelte": "^5.57.2",
		"svelte-check": "^4.6.0",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.60.1",
		"vite": "^8.3.0",
		"vitest": "^4.1.12"
	},
	"imports": {
		"#lib": "./src/lib/index.js",
		"#lib/*": "./src/lib/*"
	},
	"dependencies": {
		"@emulatorjs/core-a5200": "4.2.3",
		"@emulatorjs/core-beetle_vb": "4.2.3",
		"@emulatorjs/core-fceumm": "4.2.3",
		"@emulatorjs/core-gambatte": "4.2.3",
		"@emulatorjs/core-gearcoleco": "4.2.3",
		"@emulatorjs/core-handy": "4.2.3",
		"@emulatorjs/core-mgba": "4.2.3",
		"@emulatorjs/core-pcsx_rearmed": "4.2.3",
		"@emulatorjs/core-prosystem": "4.2.3",
		"@emulatorjs/core-smsplus": "4.2.3",
		"@emulatorjs/core-stella2014": "4.2.3",
		"@emulatorjs/core-virtualjaguar": "4.2.3",
		"@emulatorjs/emulatorjs": "4.2.3",
		"@fortawesome/fontawesome-free": "^7.3.1",
		"bootstrap": "^5.3.8",
		"bootstrap-icons": "^1.13.2",
		"dompurify": "^3.4.17",
		"marked": "^18.1.3"
	},
	"engines": {
		"node": ">=24"
	},
	"overrides": {
		"@emulatorjs/cores": "npm:@emulatorjs/core-gambatte@4.2.3",
		"@emulatorjs/emulatorjs": "$@emulatorjs/emulatorjs"
	}
}
